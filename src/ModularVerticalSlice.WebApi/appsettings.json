{
  "OpenTelemetry": {
    "ServiceName": "ModularVerticalSlice",
    "Otlp": {
      "Endpoint": ""
    }
  },
  "Bookings": {
    "Lifecycle": {
      "PaymentWindow": "00:15:00"
    }
  },
  "Payments": {
